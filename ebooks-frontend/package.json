{
  "name": "ebooks-frontend",
  "version": "1.0.0",
  "private": true,
  "proxy": "http://localhost:8080",
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "axios": "1.15.2",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "react": "^19.2.4",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:coverage": "react-scripts test --coverage --coverageReporters=lcov --coverageReporters=text --watchAll=false --passWithNoTests",
    "eject": "react-scripts eject",
    "lint": "eslint src/ --max-warnings 0",
    "lint:fix": "eslint src/ --fix",
    "prepare": "husky && cd .. && git config core.hooksPath ebooks-frontend/.husky"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/index.js",
      "!src/App.js",
      "!src/reportWebVitals.js",
      "!src/setupTests.js",
      "!src/**/*.test.{js,jsx}",
      "!src/**/*.spec.{js,jsx}",
      "!src/**/*.example.{js,jsx}",
      "!src/pages/**",
      "!src/components/Navbar.js",
      "!src/components/Footer.js",
      "!src/components/AdminRoute.js",
      "!src/components/LibrarianRoute.js",
      "!src/components/PrivateRoute.js",
      "!src/components/PasswordExpirationGuard.js",
      "!src/components/ErrorBoundary.js",
      "!src/components/Loader.js",
      "!src/components/CartCounter.js",
      "!src/components/ConfirmationModal.js",
      "!src/components/LoanDurationSelector.js",
      "!src/components/PasswordInput.js",
      "!src/components/PasswordStrengthIndicator.js",
      "!src/components/PasswordWarningBanner.js",
      "!src/context/AuthContext.js",
      "!src/services/api.js",
      "!src/hooks/**",
      "!src/config/**",
      "!src/styles/**"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 75,
        "branches": 75,
        "functions": 75,
        "statements": 75
      }
    }
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
